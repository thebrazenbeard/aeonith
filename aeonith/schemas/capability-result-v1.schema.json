{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/aeonith/blob/main/aeonith/schemas/capability-result-v1.schema.json",
  "title": "Aeonith review capability response",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "request_id", "capability", "outcome", "result", "error"],
  "properties": {
    "kind": {"const": "capability.result.v1"},
    "request_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
      ]
    },
    "capability": {"const": "aeonith.review.v1"},
    "outcome": {"enum": ["ok", "rejected", "unavailable", "failed"]},
    "core_status": {
      "description": "The recognized source-core status, if the core returned one; not a verification claim.",
      "oneOf": [
        {"type": "null"},
        {"enum": ["completed", "provider_unavailable", "invalid_request", "provider_error", "invalid_provider_output"]}
      ]
    },
    "result": {
      "oneOf": [{"type": "null"}, {"type": "object"}],
      "description": "Validated completed critique, or null for non-completed and rejected responses. Its internal schema is governed by core."
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeonith:human-study-bundle:v1",
  "title": "Aeonith offline blinded-annotation study bundle",
  "description": "Local source input only. May contain private manuscripts and reviewer rationales; do not publish the bundle. The summarized output excludes them.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "aeonith.human_study_bundle.v1"},
    "records": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pair", "annotations"],
        "properties": {
          "pair": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "pair_id", "request", "A", "B", "directions"],
            "properties": {
              "schema_version": {"const": "aeonith.blind_pair.v1"},
              "pair_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
              "request": {"type": "object"},
              "A": {"type": "object"},
              "B": {"type": "object"},
              "directions": {"type": "string"}
            }
          },
          "annotations": {
            "type": "array",
            "maxItems": 40,
            "items": {"$ref": "#/$defs/study_annotation"}
          }
        }
      }
    }
  },
  "$defs": {
    "scores": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B"],
      "properties": {
        "A": {"type": "integer", "enum": [0, 1, 2]},
        "B": {"type": "integer", "enum": [0, 1, 2]}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "pair_id", "reviewer_pseudonym", "dimensions", "preference", "rationale"],
      "properties": {
        "schema_version": {"const": "aeonith.human_annotation.v1"},
        "pair_id": {"type": "string", "minLength": 1},
        "reviewer_pseudonym": {"type": "string", "minLength": 1, "maxLength": 80},
        "dimensions": {
          "type": "object", "additionalProperties": false,
          "required": ["textual_accuracy", "lens_distinctness", "critical_depth", "calibration", "actionability", "synthesis"],
          "properties": {
            "textual_accuracy": {"$ref": "#/$defs/scores"},
            "lens_distinctness": {"$ref": "#/$defs/scores"},
            "critical_depth": {"$ref": "#/$defs/scores"},
            "calibration": {"$ref": "#/$defs/scores"},
            "actionability": {"$ref": "#/$defs/scores"},
            "synthesis": {"$ref": "#/$defs/scores"}
          }
        },
        "preference": {"enum": ["A", "B", "tie", "incomparable"]},
        "rationale": {"type": "string", "minLength": 20, "maxLength": 4000}
      }
    },
    "study_annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "display_sha256", "annotation"],
      "properties": {
        "schema_version": {"const": "aeonith.study_annotation.v1"},
        "display_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "annotation": {"$ref": "#/$defs/annotation"}
      }
    }
  }
}
